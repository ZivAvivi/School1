<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="Final.MasterPage" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>לב אחד - Lev Echad</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <style>
        /*כל הצבעים הם משתנים כדי שיהיה קל יותר לקרוא ולהבדין בן הצבעים*/
        :root {
            --primary-color: #691F0C;
            --secondary-color: #B85C3C;
            --light-bg: #F5F5F5;
            --dark-text: #1D1816;
            --hover-color: #8C2D1B;
        }

        /* זה מוחק את עמוד הגלילה בצד ימין שקופץ גשיש הרבה טקסט */
        ::-webkit-scrollbar { 
            display: none;
        }

        .mpMainPage {
            padding: 48px;
        }

        body {
            direction: rtl;
            margin: 0;
            font-family: 'Segoe UI', 'David', 'sans-serif';
            background-color: var(--light-bg);
            color: var(--dark-text);
            line-height: 1.6;
        }

        .mpTable {
            width: 100%;
            border-collapse: collapse; /*מוחק את הרווח בין קצות הדף*/
            background: white;
            min-height: 100vh; /*גורם לדפים להיות תמיד בגודל של כל הדף ולא להשאיר שטח מת*/
        }

        .header{ /*גובע קבוצה להאדר*/
            height: 120px;
        }

        .mpH1 {
            color: var(--primary-color);
            font-size: 40px;
        }
        .mpH1 img { /*משפיע רק על התמונה*/
            width: 200px !important; 
            height: 100px !important;
        }

        .mpMenu {
            height: 40px !important;
            line-height: 35px;
            background: var(--primary-color);
            text-align: center;
        }

        .mpMenu a { /*משפיע רק על קישורים*/
            color: white !important;
            text-decoration: none;
            padding: 8px 16px;
            margin: 4px 8px;
            border-radius: 8px;
            transition: all 0.3s ease;
            display: inline-block;
        }

        /*כשהעכבר נמצא על קישור תשנה צבע*/
        .mpMenu a:hover {
            background: var(--hover-color);
        }

        /*clock*/
        .time-container {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #mytime {
            font-size: 19px;
            color: var(--secondary-color);
            padding: 16px;
            background: var(--light-bg);
            border-radius: 16px;
        }

        /*כל הכפתורי שלח*/
        input[type="submit"] {
            background: var(--primary-color);
            color: white;
            padding: 8px 32px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.3s ease;
            display: block;
            margin: 16px auto;
        }
        
        input[type="submit"]:hover {
            background: var(--hover-color);
        }


        footer td {
            padding: 16px;
            background: var(--primary-color);
            color: white;
            text-align: center;
        }

        footer a {
            color: white !important;
            text-decoration: none;
        }

        .login-status {
            padding: 1px;
            display: inline-block;
            background: var(--light-bg);
            border-radius: 15px;
            margin: 10px;
        }

        .login-status a {
            text-decoration: none;
            color: var(--primary-color);
            transition: all 0.3s ease;
            padding: 6px 12px;
            border-radius: 15px;
        }

        .login-status div {
            margin: 8px 0;
        }

        .login-status a:hover {
            background-color: var(--hover-color);
            color: white;
        }
    </style>

    <script>
        setInterval(time, 1000);
        function time() {
            var d = new Date();
            document.getElementById("mytime").innerHTML = d.toLocaleTimeString();
        }
    </script>
</head>
<body>
    <table class="mpTable">
        <tr class="header">
            <td style="width:20%;">
                <div class="login-status">
                    <%=loginMsg %>
                </div>
            </td>
            <td class="mpHeader" style="text-align:center;">
                <h1 class="mpH1">
                    <img src="Pics/main.png" alt="לב אחד">
                </h1>
            </td>
            <td style="width:20%;">
                <div class="time-container">
                    <h2 id="mytime" style="direction:ltr;"></h2>
                </div>
            </td>
        </tr>
        
        <tr>
            <td class="mpMenu" colspan="3">
                <%=menuStr %>
            </td>
        </tr>

        <tr>
            <td class="mpMainPage" colspan="3">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </td>
        </tr>

        <tr class="footer">
            <td colspan="3">
                <table style="width:100%;">
                    <tr>
                        <td style="width:33%; text-align:center; direction:ltr;">
                            <%= Application["counter"] %> : מונה מבקרים באתר
                        </td>
                        <td style="width:34%; text-align:center;">
                            <h3>
                                <a href="mailto:ziv.avivi.28.11@gmail.com">מייל</a> - האתר נבנה עי זיו אביבי
                            </h3>
                        </td>
                        <td style="width:33%;"></td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>